# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used solely to sync TEAM_EMAILS into the database. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Info Desk team: Google accounts allowed into /team. Comma or newline separated.
# Redeploy after changing it on Vercel; the roster syncs on boot and on sign-in.
TEAM_EMAILS=you@gmail.com,volunteer@gmail.com

# Local Supabase only (supabase/config.toml). On hosted Supabase, set these in
# Dashboard → Authentication → Sign In / Providers → Google instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
